# ==========================================
# Ather3D Environment Configuration Template
# ==========================================
# Copy this file to Backend/.env and update the values as needed:
# cp Backend/.env.example Backend/.env

# Server Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/myapp
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=Ather3dAdmin@gmail.com

# AI & Spatial 3D Integrations (Optional / Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
LUMA_API_KEY=your_luma_api_key_here
